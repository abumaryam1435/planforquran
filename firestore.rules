rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
          && data.uid is string && data.uid == userId && data.uid.size() <= 128;
      }

      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId)
                    && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId)
                    && isValidUser(incoming());
      allow delete: if false; // Users cannot be deleted manually

      match /plans/{planId} {
        function isValidPlan(data) {
          return data.keys().hasAll(['id', 'userId', 'startPage', 'endPage', 'dailyAmount', 'startDate', 'status', 'createdAt', 'updatedAt'])
            && data.userId == userId;
        }

        allow read: if isOwner(userId) && isValidId(userId) && isValidId(planId);
        allow list: if isOwner(userId) && isValidId(userId);
        
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(planId)
                      && isValidPlan(incoming())
                      && exists(/databases/$(database)/documents/users/$(userId));
        
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(planId)
                      && isValidPlan(incoming());
                      
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(planId);
      }

      match /progress/{progressId} {
        function isValidProgress(data) {
          return data.keys().hasAll(['id', 'userId', 'planId', 'date', 'tasks'])
            && data.userId == userId;
        }

        allow read: if isOwner(userId) && isValidId(userId) && isValidId(progressId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(progressId)
                      && isValidProgress(incoming())
                      && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(progressId)
                      && isValidProgress(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(progressId);
      }

      match /achievements/{achievementId} {
        function isValidAchievement(data) {
          return data.keys().hasAll(['id', 'userId', 'title', 'description', 'icon', 'dateEarned', 'type'])
            && data.userId == userId;
        }

        allow read: if isOwner(userId) && isValidId(userId) && isValidId(achievementId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(achievementId)
                      && isValidAchievement(incoming())
                      && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(achievementId)
                      && isValidAchievement(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(achievementId);
      }
    }
  }
}
